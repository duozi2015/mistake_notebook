JWT_SECRET=your-strong-jwt-secret-at-least-32-chars
# 数据库：显式 DATABASE_URL 优先；留空则按机器环境自动选 MySQL（生产→mistake_prod，开发→mistake_test）
#DATABASE_URL=
# 运行环境：production / development（留空则按主机名推断；本机 hostname 含 macbook → development）
APP_ENV=
HOST=0.0.0.0
PORT=2531
OCR_ENABLED=false

# ── MySQL 连接（真实密码放本机 .env / .env.local，不入库）──────────
# 测试环境（Mac mini 局域网）：192.168.3.157:3306

# 生产库（Mac mini 本地，仅内网）
DB_PROD_HOST=127.0.0.1
DB_PROD_PORT=3306
DB_PROD_NAME=mistake_prod
DB_PROD_USER=mistake_prod
DB_PROD_PASSWORD=change-me-prod-password

# 测试库（Mac mini 局域网，Mac Pro 远程连接）
DB_TEST_HOST=192.168.3.157
DB_TEST_PORT=3306
DB_TEST_NAME=mistake_test
DB_TEST_USER=mistake_test
DB_TEST_PASSWORD=change-me-test-password

# 自动化测试库（pytest 专用，独立于 mistake_test，可随意建表/清表）
DB_AUTOTEST_HOST=192.168.3.157
DB_AUTOTEST_PORT=3306
DB_AUTOTEST_NAME=mistake_autotest
DB_AUTOTEST_USER=mistake_autotest
DB_AUTOTEST_PASSWORD=change-me-autotest-password

# ── 本地 Ollama（试卷初稿生成）────────────────────────────────────
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=300
PAPER_MIN_QUESTIONS=8
PAPER_MAX_QUESTIONS=12
PAPER_JOB_TTL_SECONDS=3600

# ── AI 学情建议（本地 LLM 网关，OpenAI 兼容协议）──────────────────
# 密钥等敏感配置放仓库根 .env.local（gitignore，模板见 .env.local.example）
AI_SUGGEST_ENABLED=true
AI_BASE_URL=https://your-llm-gateway.example.top
AI_MODEL=qwen3.5:9b
AI_API_KEY=
AI_TIMEOUT_SECONDS=90
